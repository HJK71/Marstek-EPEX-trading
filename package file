# =========================================================
# Package: Daytime Battery Arbitrage – Sensors & Automations Versie 1.1 
# =========================================================

# -------------------------------
# Helpers: Booleans and Numbers
# -------------------------------
input_boolean:
  epex_trading_active:
    name: EPEX Trading Active
  daytime_charging_active:
    name: Daytime Charging Active
  daytime_discharging_active:
    name: Daytime Discharging Active

input_number:
  battery_efficiency_loss:
    name: Battery Efficiency Loss (%)
    min: 0
    max: 50
    step: 1
    unit_of_measurement: "%"
    mode: box
    initial: 20

  battery_depreciation:
    name: Battery Depreciation (€/kWh)
    min: 0
    max: 0.15
    step: 0.0045
    unit_of_measurement: "€/kWh"
    mode: box
    initial: 0.05

  battery_charge_power:
    name: Charge Power (W)
    min: 100
    max: 5000
    step: 50
    unit_of_measurement: "W"
    mode: box
    initial: 2000

  battery_discharge_power:
    name: Discharge Power (W)
    min: 100
    max: 5000
    step: 50
    unit_of_measurement: "W"
    mode: box
    initial: 2300

  full_charge_price:
    name: Full Charge Price (€/kWh)
    min: 0
    max: 1
    step: 0.001
    unit_of_measurement: "€/kWh"
    mode: box
    initial: 0.2

  full_discharge_price:
    name: Full Discharge Price (€/kWh)
    min: 0
    max: 1
    step: 0.001
    unit_of_measurement: "€/kWh"
    mode: box
    initial: 0.3

# battery_arbitrage_day_result:
#  name: Battery Arbitrage Dagresultaat (22–22)
#  min: -1000
#  max: 1000
#   step: 0.01
#   unit_of_measurement: "€"
#   mode: box
#   initial: 0.0

  battery_arbitrage_total:
    name: Battery Arbitrage Totaal
    min: -10000
    max: 10000
    step: 0.01
    unit_of_measurement: "€"
    mode: box

# =========================================================
# Template Sensors – Daytime Battery Arbitrage
# =========================================================
template:


  - binary_sensor:
      - name: cheapest_before_expensive_daytime
        unique_id: bs_cheapest_before_expensive_daytime
        icon: >
          {% if is_state('binary_sensor.cheapest_before_expensive_daytime', 'on') %}
            mdi:arrow-right-bold
          {% else %}
            mdi:arrow-left-bold
          {% endif %}
        state: >
          {% set cheap = states('sensor.start_time_charging_daytime') %}
          {% set expensive = states('sensor.start_time_discharging_daytime') %}

          {% if cheap not in ['unknown','unavailable',''] 
                and expensive not in ['unknown','unavailable',''] %}
            {{ cheap < expensive }}
          {% else %}
            false
          {% endif %}


  - binary_sensor:
      - name: epex_profitable_daytime
        unique_id: bs_epex_profitable_daytime
        state: >
          {% set diff = states('sensor.price_difference_most_vs_cheapest_daytime') | float(0) %}
          {% set cheap_avg = states('sensor.average_price_cheapest_hours_daytime') | float(0) %}
          {% set efficiency_loss = states('input_number.battery_efficiency_loss') | float / 100 %}
          {% set depreciation = states('input_number.battery_depreciation') | float %}
          {% set correct_order = is_state('binary_sensor.cheapest_before_expensive_daytime', 'on') %}

          {{ 'on' if (diff > (cheap_avg * efficiency_loss + depreciation) and correct_order) else 'off' }}
        # Staat "on" als prijsverschil groot genoeg is voor winst met batterij
        # EN de goedkoopste uren vóór de duurste uren liggen.
        # Motivatie:
        # Zo wordt voorkomen dat de batterij actief wordt wanneer de dagprijscurve omgekeerd is,
        # wat negatief rendement zou veroorzaken.


      - name: full_charge_trigger
        unique_id: bs_full_charge_trigger
        state: >
          {% set full_price = states('input_number.full_charge_price') | float(0) %}
          {% set daily_low = states('sensor.average_price_cheapest_hours_daytime') | float(0) %}
          {{ 'on' if full_price >= daily_low else 'off' }}
        # Staat "on" als volledig laden toegestaan is (prijs niet te hoog).

      - name: full_discharge_trigger
        unique_id: bs_full_discharge_trigger
        state: >
          {% set full_price = states('input_number.full_discharge_price') | float(0) %}
          {% set daily_high = states('sensor.average_price_most_expensive_hours_daytime') | float(0) %}
          {% set soc = states('sensor.average_battery_soc') | float(0) %}
          {{ 'on' if (full_price <= daily_high and soc >= 12) else 'off' }}

        # Staat "on" als volledig ontladen toegestaan is (prijs niet te laag) en de batterij voller dan 11% is.

      - name: battery_charge_action_allowed
        unique_id: bs_battery_charge_action_allowed
        icon: >
          {% if is_state('binary_sensor.battery_charge_action_allowed', 'on') %}
            mdi:battery-play
          {% else %}
            mdi:battery-lock
          {% endif %}
        state: >
          {{
            is_state('input_boolean.epex_trading_active', 'on') and
            (
              is_state('binary_sensor.full_charge_trigger', 'on')
              or is_state('binary_sensor.epex_profitable_daytime', 'on')
            )
          }}
        attributes:
          full_charge_trigger: "{{ states('binary_sensor.full_charge_trigger') }}"
          epex_profitable_daytime: "{{ states('binary_sensor.epex_profitable_daytime') }}"
        # Staat "on" als laden is toegestaan EN EPEX trading actief is.

      - name: battery_discharge_action_allowed
        unique_id: bs_battery_discharge_action_allowed
        icon: >
          {% if is_state('binary_sensor.battery_discharge_action_allowed', 'on') %}
            mdi:battery-alert
          {% else %}
            mdi:battery-lock
          {% endif %}
        state: >
          {{
            is_state('input_boolean.epex_trading_active', 'on') and
            (
              is_state('binary_sensor.full_discharge_trigger', 'on')
              or is_state('binary_sensor.epex_profitable_daytime', 'on')
            )
          }}
        attributes:
          full_discharge_trigger: "{{ states('binary_sensor.full_discharge_trigger') }}"
          epex_profitable_daytime: "{{ states('binary_sensor.epex_profitable_daytime') }}"
        # Staat "on" als ontladen is toegestaan EN EPEX trading actief is.


      - name: charging_cheapest_hours_active
        unique_id: bs_charging_cheapest_hours_active
        icon: mdi:battery-charging
        state: >
          {{
            is_state('input_boolean.epex_trading_active', 'on')
            and is_state('binary_sensor.battery_charge_action_allowed', 'on')
            and is_state('binary_sensor.cheapest_hours_daytime', 'on')
          }}
        # Staat "on" als actief laden tijdens goedkoopste uren mag plaatsvinden.
        # Vereist: EPEX trading actief, laadactie toegestaan, het is een goedkoop uur.

      - name: discharging_expensive_hours_active
        unique_id: bs_discharging_expensive_hours_active
        icon: mdi:battery-arrow-up
        state: >
          {{
            is_state('input_boolean.epex_trading_active', 'on')
            and is_state('binary_sensor.battery_discharge_action_allowed', 'on')
            and is_state('binary_sensor.most_expensive_hours_daytime', 'on')
          }}
        # Staat "on" als actief ontladen tijdens duurste uren mag plaatsvinden.
        # Vereist: EPEX trading actief, ontlaadactie toegestaan, het is een duur uur.

      - name: cheapest_hours_daytime
        unique_id: bs_cheapest_hours_daytime
        state: >
          {% from 'cheapest_energy_hours.jinja' import cheapest_energy_hours %}
          {{ cheapest_energy_hours(
              'sensor.zonneplan_current_electricity_tariff',
              lowest=true, hours=3, start='00:00', end='23:59', mode='is_now'
          ) | bool }}
        # Staat "on" als huidig uur één van de goedkoopste 3 uren van de dag is.

      - name: most_expensive_hours_daytime
        unique_id: bs_most_expensive_hours_daytime
        state: >
          {% from 'cheapest_energy_hours.jinja' import cheapest_energy_hours %}
          {{ cheapest_energy_hours(
              'sensor.zonneplan_current_electricity_tariff',
              lowest=false, hours=2, start='00:00', end='23:59', mode='is_now'
          ) | bool }}
        # Staat "on" als huidig uur één van de duurste 2 uren van de dag is.

  - sensor:
      - name: average_price_cheapest_hours_daytime
        unique_id: s_avg_price_cheapest_daytime
        unit_of_measurement: "€/kWh"
        state: >
          {% from 'cheapest_energy_hours.jinja' import cheapest_energy_hours %}
          {{ (cheapest_energy_hours(
              'sensor.zonneplan_current_electricity_tariff',
              lowest=true, hours=3, start='00:00', end='23:59', mode='average'
          ) | float(0) / 10000000) | round(3) }}
        # Gemiddelde prijs van de goedkoopste 3 daguren (€/kWh).

      - name: average_price_most_expensive_hours_daytime
        unique_id: s_avg_price_expensive_daytime
        unit_of_measurement: "€/kWh"
        state: >
          {% from 'cheapest_energy_hours.jinja' import cheapest_energy_hours %}
          {{ (cheapest_energy_hours(
              'sensor.zonneplan_current_electricity_tariff',
              lowest=false, hours=2, start='00:00', end='23:59', mode='average'
          ) | float(0) / 10000000) | round(3) }}
        # Gemiddelde prijs van de duurste 2 daguren (€/kWh).

      - name: price_difference_most_vs_cheapest_daytime
        unique_id: s_price_diff_daytime
        unit_of_measurement: "€/kWh"
        state: >
          {{ (states('sensor.average_price_most_expensive_hours_daytime') | float(0)
             - states('sensor.average_price_cheapest_hours_daytime') | float(0)) | round(3) }}
        # Verschil tussen duurste en goedkoopste uren, gebruikt voor winstberekening.

      - name: start_time_charging_daytime
        unique_id: s_start_charging_daytime
        state: >
          {% from 'cheapest_energy_hours.jinja' import cheapest_energy_hours %}
          {% set t = cheapest_energy_hours(
              'sensor.zonneplan_current_electricity_tariff',
              lowest=true, hours=3, start='00:00', end='23:59', mode='start'
          ) %}
          {{ as_datetime(t).strftime('%H:%M')
             if t not in ('unknown','unavailable', none) else '00:00' }}
        # Startuur van goedkoopste laaduren.

      - name: start_time_discharging_daytime
        unique_id: s_start_discharging_daytime
        state: >
          {% from 'cheapest_energy_hours.jinja' import cheapest_energy_hours %}
          {% set t = cheapest_energy_hours(
              'sensor.zonneplan_current_electricity_tariff',
              lowest=false, hours=2, start='00:00', end='23:59', mode='start'
          ) %}
          {{ as_datetime(t).strftime('%H:%M')
             if t not in ('unknown','unavailable', none) else '00:00' }}
        # Startuur van duurste ontlaaduren.

      - name: totaal_ac_vermogen_thuisbatterijen
        unique_id: totaal_ac_vermogen_thuisbatterijen
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: >
          {{ states('sensor.lilygo_rs485_marstek_ac_power') | float(0)
           + states('sensor.lilygo_rs485_2_marstek_ac_power') | float(0)
           + states('sensor.lilygo_rs485_3_marstek_ac_power') | float(0) }}
        # Totale AC output van alle batterijen (W).

      - name: average_battery_soc
        unique_id: average_avg_battery_soc
        unit_of_measurement: "%"
        device_class: battery
        state_class: measurement
        state: >
          {{ (
            states('sensor.lilygo_rs485_marstek_battery_state_of_charge') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_battery_state_of_charge') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_battery_state_of_charge') | float(0)
          ) / 3 | round(0) }}
        # Gemiddelde SOC van alle batterijen (%).

      - name: battery_efficiency_actual
        unique_id: s_battery_efficiency_actual
        unit_of_measurement: "%"
        icon: mdi:battery-off
        device_class: battery
        state_class: measurement
        state: >
          {% set total_charging =
            states('sensor.lilygo_rs485_marstek_monthly_charging_energy') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_monthly_charging_energy') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_monthly_charging_energy') | float(0) %}
          {% set total_discharging =
            states('sensor.lilygo_rs485_marstek_monthly_discharging_energy') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_monthly_discharging_energy') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_monthly_discharging_energy') | float(0) %}
          {% if total_charging > 0 %}
            {{ (100 - ((total_discharging / total_charging) * 100)) | round(1) }}
          {% else %}
            0
          {% endif %}


      - name: battery_arbitrage_income
        unique_id: s_battery_arbitrage_income
        unit_of_measurement: "€"
        device_class: monetary
        state_class: measurement
        state: >
          {% set charging =
            states('sensor.lilygo_rs485_marstek_daily_charging_energy') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_daily_charging_energy') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_daily_charging_energy') | float(0) %}
          {% set discharging =
            states('sensor.lilygo_rs485_marstek_daily_discharging_energy') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_daily_discharging_energy') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_daily_discharging_energy') | float(0) %}
          {% set prijs_hoog = states('sensor.average_price_most_expensive_hours_daytime') | float(0) %}
          {% set prijs_laag = states('sensor.average_price_cheapest_hours_daytime') | float(0) %}
          {{ ((discharging * prijs_hoog) - (charging * prijs_laag)) | round(2) }}
        # Dagelijkse winst van batterij arbitrage (€), berekend met laad/ontlaad energie en EPEX prijzen.

  - sensor:
      - name: Battery Arbitrage Income
        unique_id: battery_arbitrage_income
        unit_of_measurement: "€"
        state: >
          {% set efficiency_loss = states('input_number.battery_efficiency_loss') | float(20) / 100 %}
          {% set charging_kwh =
            states('sensor.lilygo_rs485_marstek_daily_charging_energy') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_daily_charging_energy') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_daily_charging_energy') | float(0)
          %}
          {% set discharging_kwh =
            states('sensor.lilygo_rs485_marstek_daily_discharging_energy') | float(0) +
            states('sensor.lilygo_rs485_2_marstek_daily_discharging_energy') | float(0) +
            states('sensor.lilygo_rs485_3_marstek_daily_discharging_energy') | float(0)
          %}
          {% set full_charge_price = states('input_number.full_charge_price') | float(0.15) %}
          {% set full_discharge_price = states('input_number.full_discharge_price') | float(0.4) %}

          {{
            (
              (discharging_kwh * (1 - efficiency_loss)) * full_discharge_price
              -
              charging_kwh * full_charge_price
            ) | round(3)
          }}

# =========================================================
# Automations – Daytime Battery Charging & Discharging
# =========================================================

automation:
# -------------------------------
# Daytime Battery Charging (Cheapest Hours)
# -------------------------------
- alias: Daytime Battery Charging (Cheapest Hours)
  id: battery_charging_automation
  mode: single
  trigger:
    - platform: state
      entity_id: binary_sensor.charging_cheapest_hours_active
      to: "on"
  action:
    # Enable all 3 batteries
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: select
      entity_id: select.lilygo_rs485_marstek_rs485_control_mode
      type: select_option
      option: enable
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: select
      entity_id: select.lilygo_rs485_2_marstek_rs485_control_mode
      type: select_option
      option: enable
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: select
      entity_id: select.lilygo_rs485_3_marstek_rs485_control_mode
      type: select_option
      option: enable

    - delay: "00:00:03"

    # Set fixed charge power for all batteries
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: number
      entity_id: number.lilygo_rs485_marstek_forcible_charge_power
      type: set_value
      value: 2050
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: number
      entity_id: number.lilygo_rs485_2_marstek_forcible_charge_power
      type: set_value
      value: 2050
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: number
      entity_id: number.lilygo_rs485_3_marstek_forcible_charge_power
      type: set_value
      value: 2050

    # Start charging
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: select
      entity_id: select.lilygo_rs485_marstek_forcible_charge_discharge
      type: select_option
      option: charge
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: select
      entity_id: select.lilygo_rs485_2_marstek_forcible_charge_discharge
      type: select_option
      option: charge
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: select
      entity_id: select.lilygo_rs485_3_marstek_forcible_charge_discharge
      type: select_option
      option: charge

    # Mark daytime charging as active
    - service: input_boolean.turn_on
      target:
        entity_id: input_boolean.daytime_charging_active

    # Notification
    - service: notify.mobile_app_iphone_van # change to youre phone
      data:
        title: "🔋 Batterij laden gestart"
        message: >
          Cheap price: {{ states('sensor.average_price_cheapest_hours_daytime') }} €/kWh
          Prijsverschil: {{ states('sensor.price_difference_most_vs_cheapest_daytime') }} €/kWh

