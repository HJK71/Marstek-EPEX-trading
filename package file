  id: battery_discharging_automation
  mode: single
  trigger:
    - platform: state
      entity_id: binary_sensor.discharging_expensive_hours_active
      to: "on"
  action:
    # Enable all 3 batteries
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: select
      entity_id: select.lilygo_rs485_marstek_rs485_control_mode
      type: select_option
      option: enable
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: select
      entity_id: select.lilygo_rs485_2_marstek_rs485_control_mode
      type: select_option
      option: enable
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: select
      entity_id: select.lilygo_rs485_3_marstek_rs485_control_mode
      type: select_option
      option: enable

    - delay: "00:00:03"

    # Set fixed discharge power
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: number
      entity_id: number.lilygo_rs485_marstek_forcible_discharge_power
      type: set_value
      value: 2300
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: number
      entity_id: number.lilygo_rs485_2_marstek_forcible_discharge_power
      type: set_value
      value: 2300
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: number
      entity_id: number.lilygo_rs485_3_marstek_forcible_discharge_power
      type: set_value
      value: 2300

    # Start discharging
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: select
      entity_id: select.lilygo_rs485_marstek_forcible_charge_discharge
      type: select_option
      option: discharge
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: select
      entity_id: select.lilygo_rs485_2_marstek_forcible_charge_discharge
      type: select_option
      option: discharge
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: select
      entity_id: select.lilygo_rs485_3_marstek_forcible_charge_discharge
      type: select_option
      option: discharge

    # Mark daytime discharging as active
    - service: input_boolean.turn_on
      target:
        entity_id: input_boolean.daytime_discharging_active

    # Notification
    - service: notify.mobile_app_iphone_van # change to your phone
      data:
        title: "⚡ Batterij ontladen gestart"
        message: >
          Expensive price: {{ states('sensor.average_price_most_expensive_hours_daytime') }} €/kWh
          Prijsverschil: {{ states('sensor.price_difference_most_vs_cheapest_daytime') }} €/kWh

# -------------------------------
# Stop Battery Action on Price Window End
# -------------------------------

- alias: Stop Battery Action on Price Window End
  description: Stop battery charging/discharging when active window ends
  mode: single
  trigger:
    - platform: state
      entity_id:
        - binary_sensor.charging_cheapest_hours_active
        - binary_sensor.discharging_expensive_hours_active
      to: "off"

  condition:
    - condition: or
      conditions:
        - condition: state
          entity_id: input_boolean.daytime_charging_active
          state: "on"
        - condition: state
          entity_id: input_boolean.daytime_discharging_active
          state: "on"

  action:
    # Stop alle batterijen
    - device_id: 86781cfb31ca692028e38414353cc0f7
      domain: select
      entity_id: select.lilygo_rs485_marstek_forcible_charge_discharge
      type: select_option
      option: stop
    - device_id: bbe6f73c6270019cc883e93addcec37a
      domain: select
      entity_id: select.lilygo_rs485_2_marstek_forcible_charge_discharge
      type: select_option
      option: stop
    - device_id: 98c6f06eb2a7ffa066046c40f3d82d3d
      domain: select
      entity_id: select.lilygo_rs485_3_marstek_forcible_charge_discharge
      type: select_option
      option: stop

    # Reset flags (alleen wat actief was)
    - choose:
        - conditions:
            - condition: state
              entity_id: input_boolean.daytime_charging_active
              state: "on"
          sequence:
            - service: input_boolean.turn_off
              target:
                entity_id: input_boolean.daytime_charging_active

        - conditions:
            - condition: state
              entity_id: input_boolean.daytime_discharging_active
              state: "on"
          sequence:
            - service: input_boolean.turn_off
              target:
                entity_id: input_boolean.daytime_discharging_active

    # Notificatie (zelfde automation, geen extra logica)
    - service: notify.mobile_app_iphone_van # change to your phone
      data:
        title: "🛑 Batterij gestopt"
        message: >
          {% if is_state('input_boolean.daytime_charging_active', 'on') %}
          Laden gestopt – goedkoop prijsvenster afgelopen.
          {% elif is_state('input_boolean.daytime_discharging_active', 'on') %}
          Ontladen gestopt – duur prijsvenster afgelopen.
          {% else %}
          Batterijactie gestopt.
          {% endif %}


# =========================================================
# Automation – Add Battery Daily Income to Total
# =========================================================

- alias: Add Battery Daily Income to Total
  id: add_battery_daily_income_to_total
  trigger:
    - platform: time
      at: "23:59:00"
  action:
    - service: input_number.set_value
